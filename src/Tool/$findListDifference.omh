# If pick(pCols_opt<>'',kTrue,pos(pOldList.$cols.[col].$name,pExcludeCols_opt))
# Breakpoint
# End If
# If pick(pExcludeCols_opt<>'',kTrue,not(pos(con(pOldList.$cols.[col].$name,','),pExcludeCols_opt)))
# Breakpoint
# End If