# Refreshes everything derived from the executor text: target and title (unless from log),
# references, find, jump block, jump list height and LOC count.

If cOverwritePathAndTitle&not(pFromLog_opt)
	# a script that reads targetRef takes its target from the field: the path there stays (A, 2026-09-23)
	If not($cinst.$targetIsParam(cScript))
		Calculate cTargetPath as $cinst.$shortPath($cinst.$analyzeTarget(cScript)) ## shown short, resolved from the reference
		Calculate cSourcePath as cTargetPath
	End If
	Calculate cLogTitle as $cinst.$titleFromScript(cScript,cTargetPath,cSourcePath)
End If

If len(cTargetPath)
	Set reference iTargetRef to iTools.$pathToRefQuiet(cTargetPath) ## empty when it does not resolve, and silent either way
End If
If len(cSourcePath)
	Set reference iSourceRef to iTools.$pathToRefQuiet(cSourcePath) ## empty when it does not resolve
End If

Calculate iTextAssigned as kFalse

If len(cFindScriptText)&pos(low(cFindScriptText),low(cScript))
	# select key word in cScript field
	Do $cinst.$findInScript(0,kFalse,kTrue) Returns found ## pKeepSelection_opt= ktrue
Else
	Queue set current field hlLog
End If


# the script changed as a whole (log row, snippet, a paste over most of the text): a version note may come again, see $versionCheck
If pJumpsIfPossible_opt
	Calculate iVersionWarnedRun as ''
	Calculate iVersionWarnedJump as ''
End If

If pJumpsIfPossible_opt&cViewAuto
	# loading with the automatic on: the view follows the content, no memory (0 Script, 1 Split, 2 Jump)
	# the fixed start of the marker only: since 1.0 a version may follow it
	If pos(con('## =====',' JUMP LINKS'),cScript)=0
		Calculate cView as 0
	Else If $cinst.$isJumpOnly(cScript)
		Calculate cView as 2
		Calculate cFixJumpLine as kFalse ## Jump starts with each line fitting its text
	Else
		Calculate cView as 1
	End If
End If
Do $cinst.$applyView() ## parse, client field, heights: script, split or jump
Do iTools.$calcLOC(cScript,iTotalLOC,iSLOC)

Calculate iMarkPick.$line as 1 ## none, unless the search lands on the marker
Do iMarkPick.$search(iMarkPick.markno=pick(isnull(cLog.execMark),cLog.execMark,0),kTrue,kFalse,kFalse,kFalse) Returns found ## dlMark shows the marker of the current log row
If not(found)
	Calculate iMarkPick.$line as 1 ## an emptied row or out of range reads as none
End If
Quit method