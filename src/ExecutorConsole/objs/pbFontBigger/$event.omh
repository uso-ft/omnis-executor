On evClick
	Calculate cTextSize as cTextSize+1
	If cTextSize>30
		Calculate cTextSize as 30
	End If
	Do $cinst.$setTextSize()
	
	If not(cFixJumpLine)
		Calculate line as cJumpLinks.$line
		Do $cinst.$adjustJumpLineHeight()
		Calculate cJumpLinks.$line as line
		Do $cinst.$redraw()
	End If