# Stores pValue as binary in the $userinfo of the class variable named pKey
# Returns kTrue if success

If $cclass.$cvardefs.$findname(pKey)
Else
	Do $cclass.$cvardefs.$add(pKey)
End If

Set reference ref to $cclass.$cvardefs.$findname(pKey)
If isclear(ref)
	OK message ExecutorStore: Key:'[pKey]' could not be created (Sound bell) {Cannot backup/restore Key:'[pKey]' }
	Quit method kFalse
End If

Do ref.$userinfo.$assign(pValue)
Save class [iTools.$shortenClassPath($cclass().$fullname)]
Calculate saved as #F

Quit method saved